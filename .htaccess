# Garras Astrales: Apache settings for SiteGround

# Send everyone to the secure https:// address
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Friendly "page not found"
ErrorDocument 404 /404.html

# Don't show folder listings
Options -Indexes

# Keep project files private
<FilesMatch "^(README\.md|\.gitignore|logo-sheet-original\.png)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# Let browsers cache images, CSS and JS (pages themselves stay fresh)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
